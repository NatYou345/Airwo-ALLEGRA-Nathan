    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "react-spinners": "^0.17.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
